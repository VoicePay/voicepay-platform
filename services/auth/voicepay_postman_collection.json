{
  "info": {
    "name": "VoicePay Auth API",
    "description": "Collection for testing VoicePay voice authentication endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Registration",
      "item": [
        {
          "name": "Register User with Voice Sample",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('User created:', jsonData);",
                  "    pm.environment.set('email', jsonData.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "first_name",
                  "value": "Alice",
                  "type": "text"
                },
                {
                  "key": "last_name",
                  "value": "Johnson",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "alice{{$timestamp}}@voicepay.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "SecurePass123!",
                  "type": "text"
                },
                {
                  "key": "voice_sample",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/voice-users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voice-users",
                ""
              ]
            },
            "description": "Register a new user with a voice sample. Upload a .wav file (16kHz mono recommended)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Voice Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('refresh_token', jsonData.refresh);",
                  "    console.log('Login successful, tokens set');",
                  "} else {",
                  "    console.log('Login failed:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "voice_sample",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/voice-users/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voice-users",
                "login",
                ""
              ]
            },
            "description": "Authenticate using voice sample. Use the same .wav file or similar for testing."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Refresh the access token using the refresh token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protected Endpoints",
      "item": [
        {
          "name": "List Voice Users (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/voice-users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voice-users",
                ""
              ]
            },
            "description": "Retrieve list of voice users (requires valid access token)"
          },
          "response": []
        },
        {
          "name": "Get User Detail (Authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/voice-users/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voice-users",
                "1",
                ""
              ]
            },
            "description": "Get user detail by ID (replace 1 with actual user ID)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "API Documentation",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/swagger/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "swagger",
                ""
              ]
            },
            "description": "Interactive API documentation (open in browser)"
          },
          "response": []
        },
        {
          "name": "ReDoc",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/redoc/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "redoc",
                ""
              ]
            },
            "description": "ReDoc API documentation (open in browser)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ]
}
